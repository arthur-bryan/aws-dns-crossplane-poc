        <mxCell id="aws-step6-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#827717;spacingLeft=14;" value="&lt;b&gt;AWS — dev-account (222222222222)&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="1380" x="80" y="548" as="geometry" />
        </mxCell>
        <mxCell id="r53-priv" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ffffff;strokeColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.route_53;" value="" vertex="1">
          <mxGeometry height="48" width="48" x="120" y="572" as="geometry" />
        </mxCell>
        <mxCell id="vpc-dev3" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ffffff;strokeColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.virtual_private_cloud_VPC;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="178" y="576" as="geometry" />
        </mxCell>
        <mxCell id="aws-step6-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#827717;spacingLeft=10;" value="Provider authenticates via the &lt;b&gt;dev-account&lt;/b&gt; ClusterProviderConfig (credentials.source: IRSA + assumeRoleChain into dev-account) and calls &lt;b&gt;CreateHostedZone&lt;/b&gt; with the same-account VPC inline →&#xa;AWS creates the private hosted zone internal.example.com (new zoneId, ZCHILD789) and attaches vpc-default-dev immediately" vertex="1">
          <mxGeometry height="48" width="1228" x="232" y="572" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="7" vertex="1">
          <mxGeometry height="32" width="32" x="20" y="666" as="geometry" />
        </mxCell>
        <mxCell id="auth-mr" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#00838F;strokeColor=#004D40;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="" vertex="1">
          <mxGeometry height="78" width="80" x="80" y="656" as="geometry" />
        </mxCell>
        <mxCell id="auth-mr-l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#ffffff;" value="MR" vertex="1">
          <mxGeometry height="24" width="50" x="94" y="683" as="geometry" />
        </mxCell>
        <mxCell id="auth-mr-spec" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838F;fontSize=10;align=left;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; kind: VPCAssociationAuthorization (route53.aws.m.upbound.io)&#xa;providerConfigRef.name: dev-account     ← zone owner side (same account as the private zone)&#xa;forProvider.vpcId: vpc-app-prod   ·   forProvider.zoneId: ZCHILD789&#xa;→ Provider calls &lt;b&gt;AWS dev-account: CreateVPCAssociationAuthorization&lt;/b&gt;  (authorizes the cross-account VPC)" vertex="1">
          <mxGeometry height="78" width="1280" x="180" y="656" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="8" vertex="1">
          <mxGeometry height="32" width="32" x="20" y="776" as="geometry" />
        </mxCell>
        <mxCell id="assoc-mr" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#00838F;strokeColor=#004D40;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="" vertex="1">
          <mxGeometry height="78" width="80" x="80" y="766" as="geometry" />
        </mxCell>
        <mxCell id="assoc-mr-l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#ffffff;" value="MR" vertex="1">
          <mxGeometry height="24" width="50" x="94" y="793" as="geometry" />
        </mxCell>
        <mxCell id="assoc-mr-spec" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838F;fontSize=10;align=left;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; kind: ZoneAssociation (route53.aws.m.upbound.io)&#xa;providerConfigRef.name: prod-account     ← VPC owner side (cross-account)&#xa;forProvider.vpcId: vpc-app-prod   ·   forProvider.zoneId: ZCHILD789&#xa;→ Provider calls &lt;b&gt;AWS prod-account: AssociateVPCWithHostedZone&lt;/b&gt;  (attaches vpc-app-prod to the private zone)" vertex="1">
          <mxGeometry height="78" width="1280" x="180" y="766" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3F51B5;strokeColor=#1A237E;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="9" vertex="1">
          <mxGeometry height="32" width="32" x="20" y="876" as="geometry" />
        </mxCell>
        <mxCell id="rule-card" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=11;align=left;spacingLeft=14;spacingTop=8;fontStyle=2;" value="&lt;b&gt;Route 53 cross-account contract&lt;/b&gt;&#xa;CreateVPCAssociationAuthorization is called by the &lt;b&gt;zone owner&lt;/b&gt; (dev-account) ;  AssociateVPCWithHostedZone is called by the &lt;b&gt;VPC owner&lt;/b&gt; (prod-account).&#xa;Both Managed Resources stamp a deterministic external-name = zoneId:vpcId so the handshake is idempotent across reconciles." vertex="1">
          <mxGeometry height="74" width="1380" x="80" y="870" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;fontStyle=1;" value="10" vertex="1">
          <mxGeometry height="32" width="32" x="20" y="976" as="geometry" />
        </mxCell>
        <mxCell id="final-priv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=12;fontStyle=1;fontColor=#827717;align=center;" value="&lt;b&gt;Final state&lt;/b&gt; — internal.example.com (in dev-account) resolves privately for both VPCs:&#xa;vpc-default-dev  (same-account, inlined at zone creation)   ·   vpc-app-prod  (cross-account, after the Auth + Assoc handshake)" vertex="1">
          <mxGeometry height="50" width="1380" x="80" y="970" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-1" edge="1" parent="1" source="step1p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="derive-step">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-2" edge="1" parent="1" source="derive-step" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="comp-priv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-3" edge="1" parent="1" source="comp-priv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="zone-mr-priv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-4" edge="1" parent="1" source="zone-mr-priv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="aws-step6" value="Provider Observe → CreateHostedZone (with same-account VPC)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-5" edge="1" parent="1" source="aws-step6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="auth-mr" value="when zoneId observed → composition emits Auth + Assoc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-6" edge="1" parent="1" source="auth-mr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="assoc-mr" value="paired (cross-account handshake)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-7" edge="1" parent="1" source="assoc-mr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="rule-card">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p3-8" edge="1" parent="1" source="rule-card" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="final-priv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
