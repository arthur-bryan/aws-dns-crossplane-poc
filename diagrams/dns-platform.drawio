          <mxGeometry height="58" width="80" x="80" y="778" as="geometry" />
        </mxCell>
        <mxCell id="r5-mrB-l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#ffffff;" value="MR" vertex="1">
          <mxGeometry height="24" width="50" x="94" y="795" as="geometry" />
        </mxCell>
