        </mxCell>
        <mxCell id="r5-step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1116;strokeColor=#0E1116;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=14;spacingTop=4;" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Scaffolder pipeline (same as in-place edit):&#xa;fetchZone → computeKey → fetchRecord → snapshotOriginal → applyEdits → mergeParams" vertex="1">
          <mxGeometry height="58" width="1380" x="80" y="210" as="geometry" />
        </mxCell>
        <mxCell id="r5-s3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="3" vertex="1">
          <mxGeometry height="32" width="32" x="20" y="296" as="geometry" />
        </mxCell>
        <mxCell id="r5-step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#36BAA2;strokeColor=#247966;fontColor=#ffffff;fontSize=11;fontStyle=1;align=left;spacingLeft=14;spacingTop=4;" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; writeXR — branch in the Nunjucks template detects the trigger condition&#xa;&lt;b&gt;adds annotation:&lt;/b&gt;  argocd.argoproj.io/sync-options: Force=true,Replace=true&#xa;dock.tech/scaffolder-parameters is rewritten with the merged params" vertex="1">
          <mxGeometry height="62" width="1380" x="80" y="290" as="geometry" />
        </mxCell>
        <mxCell id="r5-s4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="4" vertex="1">
          <mxGeometry height="32" width="32" x="20" y="378" as="geometry" />
        </mxCell>
        <mxCell id="r5-step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#BF360C;fontSize=11;fontStyle=1;align=left;spacingLeft=14;" value="&lt;b&gt;GitOps&lt;/b&gt; &amp;nbsp;·&amp;nbsp; publish:github:pull-request opens the PR → reviewer merges → ArgoCD reads sync-options=Force,Replace and runs &lt;b&gt;kubectl replace --force&lt;/b&gt; (delete-then-create)" vertex="1">
          <mxGeometry height="48" width="1380" x="80" y="370" as="geometry" />
