        <mxCell id="r5-xrA" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5E35B1;strokeColor=#311B92;fontColor=#ffffff;fontSize=11;fontStyle=1;strokeDasharray=4;dashed=1;" value="" vertex="1">
