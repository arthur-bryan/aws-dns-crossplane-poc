        <mxCell id="r5-s9" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#BF360C;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="9" vertex="1">
