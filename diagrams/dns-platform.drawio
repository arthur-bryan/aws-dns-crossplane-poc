        <mxCell id="r5-divA" parent="1" style="text;html=1;strokeColor=#B71C1C;fillColor=#FFCDD2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#B71C1C;rounded=1;" value="phase A — destroy the old record" vertex="1">
          <mxGeometry height="22" width="1380" x="60" y="448" as="geometry" />
        </mxCell>
        <mxCell id="r5-s5" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="5" vertex="1">
