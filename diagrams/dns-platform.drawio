        <mxCell id="r5-awsDel-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#827717;spacingLeft=10;" value="Provider sees the Record MR was deleted → calls &lt;b&gt;ChangeResourceRecordSets&lt;/b&gt; with action=&lt;b&gt;DELETE&lt;/b&gt; on the dev.example.com hosted zone&#xa;Old record set ( name+type+setIdentifier ) is removed from Route 53 — &lt;b&gt;DNS gap starts here&lt;/b&gt;" vertex="1">
