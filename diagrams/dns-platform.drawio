        <mxCell id="r5-xrA-spec" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E35B1;fontSize=10;align=left;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Old XR (Record) is &lt;b&gt;deleted&lt;/b&gt; (kubectl replace --force does delete + create)&#xa;Composition tears down the composed Record MR ( same name as the XR )&#xa;ownerReferences guarantee garbage-collection of the MR when the XR disappears" vertex="1">
          <mxGeometry height="58" width="1280" x="180" y="480" as="geometry" />
        </mxCell>
        <mxCell id="r5-s6" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#BF360C;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="6" vertex="1">
