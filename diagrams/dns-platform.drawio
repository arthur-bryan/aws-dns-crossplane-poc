        </mxCell>
        <mxCell id="example5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=2;fontColor=#546E7A;" value="example: existing A record api.dev.example.com → user changes type to CNAME (type changed, OR record was originally weighted/failover/latency/geolocation/multivalue)" vertex="1">
          <mxGeometry height="20" width="1380" x="60" y="56" as="geometry" />
        </mxCell>
        <mxCell id="trigger5" parent="1" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=center;verticalAlign=middle;fontSize=11;rounded=1;fontColor=#B71C1C;" value="&lt;b&gt;Trigger condition (writeXR step in record-edit.yaml, line 250)&lt;/b&gt;:  original.type ≠ new.type  &lt;b&gt;OR&lt;/b&gt;  original.routingPolicy ≠ &amp;quot;simple&amp;quot;  →  XR is annotated with  &lt;b&gt;argocd.argoproj.io/sync-options: Force=true,Replace=true&lt;/b&gt;  →  ArgoCD does kubectl replace --force ( delete-then-create )" vertex="1">
          <mxGeometry height="28" width="1380" x="60" y="84" as="geometry" />
        </mxCell>
        <mxCell id="r5-s1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="1" vertex="1">
          <mxGeometry height="32" width="32" x="20" y="140" as="geometry" />
        </mxCell>
        <mxCell id="r5-step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1116;strokeColor=#0E1116;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=14;" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; User submits Backstage Record-Edit form&#xa;edits type ( e.g. A → CNAME )  OR  the record was originally weighted/failover/latency/geolocation/multivalue" vertex="1">
          <mxGeometry height="50" width="1380" x="80" y="130" as="geometry" />
        </mxCell>
        <mxCell id="r5-s2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="2" vertex="1">
