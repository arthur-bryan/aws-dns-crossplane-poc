  </diagram>
  <diagram name="4. Record Edit — In-Place Update (no recreation)" id="page-record-edit-inplace">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title4" value="Record Edit — In-Place Update (TTL / values / simple routing)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="1140" height="32" as="geometry" />
        </mxCell>
        <mxCell id="example4" value="example: existing A record api.dev.example.com (ttl=300, value=10.0.0.1, simple routing) → user changes ttl to 60 and value to 10.0.0.2" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=2;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="56" width="1380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="trigger4" value="&lt;b&gt;Trigger condition (writeXR step in record-edit.yaml, line 250)&lt;/b&gt;:  original.type == new.type  &lt;b&gt;AND&lt;/b&gt;  original.routingPolicy == &amp;quot;simple&amp;quot;  →  &lt;b&gt;no Force/Replace annotation&lt;/b&gt;  →  ArgoCD does a regular kubectl apply" style="text;html=1;strokeColor=#43A047;fillColor=#E8F5E9;align=center;verticalAlign=middle;fontSize=11;rounded=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="60" y="84" width="1380" height="28" as="geometry" />
        </mxCell>
        <mxCell id="r4-t1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-step1" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; User submits Backstage Record-Edit form&#xa;picks zone + recordName + type (immutable lookup keys) ; edits ttl=60, values=[10.0.0.2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1116;strokeColor=#0E1116;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="1380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r4-t2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-step2" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Scaffolder pipeline:&#xa;fetchZone (catalog:fetch parent) → computeKey (jsonata, recordName+type+setIdentifier)&#xa;fetchRecord (catalog:fetch existing entity) → snapshotOriginal (read dock.tech/scaffolder-parameters annotation)&#xa;applyEdits (json:merge user edits over original) → mergeParams (read merged result back as object)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1116;strokeColor=#0E1116;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=14;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="1380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r4-t3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-step3" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; writeXR — type unchanged AND original routing was simple → &lt;b&gt;no&lt;/b&gt; argocd.argoproj.io/sync-options annotation&#xa;dock.tech/scaffolder-parameters is rewritten with the merged params (becomes the new baseline for the next edit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#36BAA2;strokeColor=#247966;fontColor=#ffffff;fontSize=11;fontStyle=1;align=left;spacingLeft=14;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="1380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r4-t4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="408" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-step4" value="&lt;b&gt;GitOps&lt;/b&gt; &amp;nbsp;·&amp;nbsp; publish:github:pull-request opens a PR with the updated XR + catalog entity → reviewer merges → ArgoCD detects the commit on main and runs &lt;b&gt;kubectl apply&lt;/b&gt; (regular sync, no force)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#BF360C;fontSize=11;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="1380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="r4-t5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="478" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-xr" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5E35B1;strokeColor=#311B92;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="468" width="80" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r4-xr-l" value="XR" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="96" y="485" width="48" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r4-xr-spec" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; XR (Record) updated &lt;b&gt;in-place&lt;/b&gt; (same metadata.name, same UID)&#xa;forProvider.ttl: 300 → 60   ·   forProvider.records: [10.0.0.1] → [10.0.0.2]&#xa;Composition re-runs function-go-templating ; external-name annotation (zoneId_fqdn_type[_setIdentifier]) is unchanged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E35B1;fontSize=10;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="180" y="468" width="1280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r4-t6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="556" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-mr" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#00838F;strokeColor=#004D40;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="546" width="80" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r4-mr-l" value="MR" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="94" y="563" width="50" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r4-mr-spec" value="&lt;b&gt;Platform&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Record MR (route53.aws.m.upbound.io/v1beta1) — &lt;b&gt;same object&lt;/b&gt; as before&#xa;providerConfigRef.name: dev-account (kind: ClusterProviderConfig)   ·   external-name unchanged: ZCHILD456_api.dev.example.com_A&#xa;forProvider.ttl &amp; forProvider.records re-rendered with merged values ; managementPolicies = [&amp;quot;*&amp;quot;] so the MR is fully managed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838F;fontSize=10;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="180" y="546" width="1280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r4-t7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#BF360C;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="644" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-aws" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#827717;" vertex="1" parent="1">
          <mxGeometry x="80" y="634" width="1380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r4-aws-title" value="&lt;b&gt;AWS — dev-account (222222222222)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#827717;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="636" width="1380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r4-r53" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ffffff;strokeColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.route_53;" vertex="1" parent="1">
          <mxGeometry x="120" y="662" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="r4-aws-text" value="Provider Observe phase detects drift on the Record MR ( ttl/values changed ) → calls &lt;b&gt;ChangeResourceRecordSets&lt;/b&gt; with action=&lt;b&gt;UPSERT&lt;/b&gt; on the dev.example.com hosted zone&#xa;Route 53 updates the existing record set in place — same name+type+setIdentifier key, just new ttl &amp; rdata. &lt;b&gt;No DNS gap.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#827717;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="184" y="662" width="1276" height="48" as="geometry" />
        </mxCell>
        <mxCell id="r4-t8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="754" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r4-final" value="&lt;b&gt;Final state&lt;/b&gt; — same record set in Route 53 ; clients see new ttl &amp; values without any disappearance of the record. Resolvers may keep the old answer until the previous ttl expires (max old-ttl seconds)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=12;fontStyle=1;fontColor=#827717;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="748" width="1380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r4-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r4-step1" target="r4-step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r4-step2" target="r4-step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r4-step3" target="r4-step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4-e4" value="kubectl apply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r4-step4" target="r4-xr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4-e5" value="composition re-renders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r4-xr" target="r4-mr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4-e6" value="Provider Observe → Update (UPSERT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r4-mr" target="r4-aws">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
