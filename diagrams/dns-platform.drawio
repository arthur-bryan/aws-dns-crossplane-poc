          <mxGeometry height="22" width="1380" x="60" y="668" as="geometry" />
        </mxCell>
        <mxCell id="r5-s7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="7" vertex="1">
