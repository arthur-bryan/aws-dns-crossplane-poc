  <diagram name="5. Record Edit — Destructive Recreate (type / routing change)" id="page-record-edit-recreate">
    <mxGraphModel dx="2739" dy="1132" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0">
      <root>
