# Local lab — Backstage scaffolded app artifacts.
# The scaffolded app at lab/backstage/ape-lab/ has its own .gitignore that
# covers node_modules / dist / .yarn / app-config.local.yaml. These entries
# belong-and-braces it for any alternate app locations or older layouts.
lab/backstage/*/node_modules/
lab/backstage/*/.yarn/cache/
lab/backstage/*/.yarn/install-state.gz
lab/backstage/*/packages/*/dist/
lab/backstage/*/packages/*/dist-types/
lab/backstage/*/plugins/*/dist/
lab/backstage/*/plugins/*/dist-types/
lab/backstage/*/dist-types/
lab/backstage/*/app-config.local.yaml
lab/backstage/*/.env

# Runtime artifacts from backstage-up.sh / backstage-down.sh
lab/backstage/backstage.pid
lab/backstage/backstage.log

# AWS credentials (never commit)
route53-credentials
aws-credentials

# draw.io autosave/backup
*.drawio.bkp
.$*.drawio.bkp
lab/backstage/git-pull.pid
lab/backstage/git-pull.log
